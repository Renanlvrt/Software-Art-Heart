# Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=4000
NODE_ENV=development

# Database
DATABASE_PATH=./data/artheart.db

# Logging
LOG_LEVEL=debug

# Hardware Mode: 'simulator' or 'serial'
HARDWARE_MODE=simulator

# Simulator Settings
SIMULATOR_INTERVAL_MS=1000

# Serial Port (Phase 2)
# SERIAL_PORT=COM3
# SERIAL_BAUD_RATE=115200
